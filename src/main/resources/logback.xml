<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>[%d{HH:mm:ss.SSS}] [ %-5level] %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.geysermc.mcprotocollib.network.netty.PacketCodec"
          level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
